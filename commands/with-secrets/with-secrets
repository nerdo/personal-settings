#!/usr/bin/env zsh
# with-secrets: run a program with its SecretSpec profile's keys, whoever starts it: a terminal, or a program such as
# Orca that runs `gh` directly with no zsh functions.
#
# On PATH as bin/<program> (symlinks to this file); the name picks the program and its profile. Most programs use the
# profile named after them; the table below lists the ones that share another's. The keys reach this one run only.
#
# The real program is the first one of that name on PATH that is not this file, so ~/.local/bin/<program> (a symlink
# here, from zsh/bin/link-local-bin) and bin/<program> can both be on PATH.
set -u

self="${0:A}"
name="${0:t}"
repo="${self:h:h:h}"

typeset -A shared_profile=(npx npm bun npm bunx npm)
profile="${shared_profile[$name]:-$name}"

real=""
for dir in $path; do
  if [[ -x "$dir/$name" && "${${:-$dir/$name}:A}" != "$self" ]]; then real="$dir/$name"; break; fi
done
[[ -n "$real" ]] || { print -u2 "$name: no $name program on PATH besides $self"; exit 127 }

exec secretspec -f "$repo/secretspec/secretspec.toml" run --profile "$profile" --reason "$name (settings command)" -- \
  "$real" "$@"
