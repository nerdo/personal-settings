# -----------------------------------------------------
# CUSTOMIZATION
# -----------------------------------------------------

# oh-my-posh theme (must match a filename in the themes directory without extension/suffix)
# e.g. "agnoster" resolves to agnoster.omp.json
POSH=1_shell

# -----------------------------------------------------
# oh-my-zsh plugins
# External plugins (cloned into $ZSH_CUSTOM/plugins if missing)
# -----------------------------------------------------
_external_plugins=(
    "zsh-autosuggestions          https://github.com/zsh-users/zsh-autosuggestions"
    "zsh-syntax-highlighting      https://github.com/zsh-users/zsh-syntax-highlighting"
    "fast-syntax-highlighting     https://github.com/zdharma-continuum/fast-syntax-highlighting"
)

plugins=(
    git
    sudo
    web-search
    zsh-autosuggestions
    zsh-syntax-highlighting
    fast-syntax-highlighting
    copyfile
    copybuffer
    dirhistory
)

# Platform-specific plugins
if [[ -f /etc/arch-release ]]; then
    plugins+=(archlinux)
fi

# -----------------------------------------------------
# Set-up oh-my-zsh (auto-install if missing)
# -----------------------------------------------------
if [[ ! -d "$ZSH" ]]; then
    echo "oh-my-zsh not found, installing..."
    git clone https://github.com/ohmyzsh/ohmyzsh.git "$ZSH" --depth 1
fi

# Auto-install missing external plugins
ZSH_CUSTOM="${ZSH_CUSTOM:-$ZSH/custom}"
for _entry in "${_external_plugins[@]}"; do
    _plugin_name="${_entry%% *}"
    _plugin_url="${_entry##* }"
    if [[ ! -d "$ZSH_CUSTOM/plugins/$_plugin_name" ]]; then
        echo "Installing oh-my-zsh plugin: $_plugin_name..."
        git clone "$_plugin_url" "$ZSH_CUSTOM/plugins/$_plugin_name" --depth 1
    fi
done
unset _entry _plugin_name _plugin_url _external_plugins

if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
    source "$ZSH/oh-my-zsh.sh"
else
    echo "oh-my-zsh: could not load $ZSH/oh-my-zsh.sh"
fi

# -----------------------------------------------------
# Set-up FZF key bindings (CTRL R for fuzzy history finder)
# -----------------------------------------------------
if command -v fzf &>/dev/null; then
    source <(fzf --zsh)
fi

# zsh history
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory

# -----------------------------------------------------
# Prompt (oh-my-posh)
# -----------------------------------------------------
if command -v oh-my-posh &>/dev/null; then
    # Resolve themes directory cross-platform
    _posh_themes=""
    if [[ -d "/usr/share/oh-my-posh/themes" ]]; then
        _posh_themes="/usr/share/oh-my-posh/themes"            # Arch Linux
    elif command -v brew &>/dev/null; then
        _posh_themes="$(brew --prefix oh-my-posh 2>/dev/null)/themes"  # macOS Homebrew
    fi

    # An ml4w update can leave its own theme where this repo's link was. Repairing here puts this very shell on the
    # repo's theme. A .toml wins the lookup below, so a link beside it would change nothing. ZSHRC_NO_SELF_HEAL=1 runs
    # ml4w as it ships, as in zshenv.
    _posh_repo="${${(%):-%x}:A:h:h:h}"
    if [[ -z ${ZSHRC_NO_SELF_HEAL:-} && -f "$HOME/.config/ohmyposh/1_shell.omp.json" \
        && ! -e "$HOME/.config/ohmyposh/1_shell.toml" \
        && ! "$HOME/.config/ohmyposh/1_shell.omp.json" -ef "$_posh_repo/ohmyposh/1_shell.omp.json" ]]; then
        "$_posh_repo/zsh/bin/link-ohmyposh-theme"
    fi
    unset _posh_repo

    # Resolve theme config file
    _posh_config=""
    if [[ -f "$HOME/.config/ohmyposh/${POSH}.toml" ]]; then
        _posh_config="$HOME/.config/ohmyposh/${POSH}.toml"
    elif [[ -f "$HOME/.config/ohmyposh/${POSH}.omp.json" ]]; then
        _posh_config="$HOME/.config/ohmyposh/${POSH}.omp.json"
    elif [[ -f "${${(%):-%x}:A:h:h:h}/ohmyposh/${POSH}.omp.json" ]]; then
        # This repo's copy, ahead of the system themes: oh-my-posh ships its own 1_shell, which Homebrew installs. Never
        # fetched at shell start: a theme can run commands, and one from a moving branch is a prompt nobody chose.
        _posh_config="${${(%):-%x}:A:h:h:h}/ohmyposh/${POSH}.omp.json"
    elif [[ -n "$_posh_themes" && -f "${_posh_themes}/${POSH}.omp.json" ]]; then
        _posh_config="${_posh_themes}/${POSH}.omp.json"
    else
        echo "oh-my-posh: theme '${POSH}' not found in ~/.config/ohmyposh or this repo's ohmyposh/"
    fi

    if [[ -n "$_posh_config" ]]; then
        eval "$(oh-my-posh init zsh --config "$_posh_config")"
    fi
    unset _posh_config
    unset _posh_themes
fi
