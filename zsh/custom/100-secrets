# Auto-export secrets from ~/.secrets/export/
# Each file's name becomes the env var, file contents become the value.
# Secrets outside export/ are for on-demand access by other apps.
#
# Loaded from ~/.zshenv (see ../zshenv), so this runs in every shell, not just
# interactive ones. $(<file) reads in-process; $(cat file) would fork once per
# secret on every zsh invocation.
#
# Names in ../../secretspec/not-exported are skipped: SecretSpec loads those per command (150-secretspec), so only the
# command whose profile holds a name gets it. SECRETS_NOT_EXPORTED_LIST overrides the list's path (the tests use it).
#
# A shell started from an older process (a tmux server, a terminal opened before a name left export/) inherits the
# old values. An interactive shell drops the listed names it inherited, and BAO_ADMIN_TOKEN, which is never exported.
# Non-interactive shells keep them: that is how a program started through with_secrets hands its keys to its children.
_secrets_skip=()
_secrets_list="${SECRETS_NOT_EXPORTED_LIST:-${${(%):-%x}:A:h:h:h}/secretspec/not-exported}"
[[ -r $_secrets_list ]] && _secrets_skip=(${${(f)"$(<$_secrets_list)"}:#\#*})
if [[ -o interactive ]]; then
    for _secrets_name in $_secrets_skip BAO_ADMIN_TOKEN; do unset "$_secrets_name"; done
fi
if [[ -d ~/.secrets/export ]]; then
    for secret_file in ~/.secrets/export/*(-.N); do
        (( ${_secrets_skip[(Ie)${secret_file:t}]} )) && continue
        export "${secret_file:t}"="$(<"$secret_file")"
    done
fi
unset secret_file _secrets_skip _secrets_list _secrets_name
