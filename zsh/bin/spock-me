#!/usr/bin/env zsh
usage() {
  print -r -- "usage: spock-me <message>

Sends <message> to Dannel on Telegram through Spock, the n8n workflow
\"Send message via Spock to me\". Words are joined with single spaces.

Reads SPOCK_TELEGRAM_MESSAGE_WEBHOOK_URL and
SPOCK_TELEGRAM_MESSAGE_WEBHOOK_AUTH_HEADER ('Name: value') from the
environment; ~/.secrets/export/ sets both.

Exit status: 0 sent, 1 not sent, 2 usage error."
}

if (( $# == 0 )); then
  usage >&2
  exit 2
fi

# Both settings come from ~/.secrets/export/ (loaded by custom/100-secrets
# through ~/.zshenv), so a missing one names the file that would set it.
require_setting() {
  local name="$1" what="$2"
  if [[ -z "${(P)name:-}" ]]; then
    print -ru2 -- "spock-me: $name is not set. Put $what in ~/.secrets/export/$name and open a new shell."
    exit 1
  fi
}

require_setting SPOCK_TELEGRAM_MESSAGE_WEBHOOK_URL "the webhook URL"
require_setting SPOCK_TELEGRAM_MESSAGE_WEBHOOK_AUTH_HEADER "the 'Name: value' auth header"

http_status="$(
  print -r -- "$SPOCK_TELEGRAM_MESSAGE_WEBHOOK_AUTH_HEADER" |
    curl --silent --get -H @- \
      --data-urlencode "message=$*" \
      --output /dev/null --write-out '%{http_code}' \
      "$SPOCK_TELEGRAM_MESSAGE_WEBHOOK_URL"
)"
curl_status=$?

if (( curl_status != 0 )); then
  print -ru2 -- "spock-me: could not reach Spock at the webhook URL (curl exit $curl_status). Check the network and that n8n is up."
  exit 1
fi

if [[ "$http_status" != 2* ]]; then
  print -ru2 -- "spock-me: Spock refused the message (HTTP $http_status). On 403, check that SPOCK_TELEGRAM_MESSAGE_WEBHOOK_AUTH_HEADER matches the workflow's Header Auth credential."
  exit 1
fi
