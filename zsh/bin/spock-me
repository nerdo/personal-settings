#!/usr/bin/env zsh
if [[ -z "${SPOCK_TELEGRAM_MESSAGE_WEBHOOK_URL:-}" ]]; then
  print -ru2 -- "spock-me: SPOCK_TELEGRAM_MESSAGE_WEBHOOK_URL is not set. Put the webhook URL in ~/.secrets/export/SPOCK_TELEGRAM_MESSAGE_WEBHOOK_URL and open a new shell."
  exit 1
fi

print -r -- "$SPOCK_TELEGRAM_MESSAGE_WEBHOOK_AUTH_HEADER" |
  curl --silent --get -H @- \
    --data-urlencode "message=$*" \
    "$SPOCK_TELEGRAM_MESSAGE_WEBHOOK_URL" > /dev/null
