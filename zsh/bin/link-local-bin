#!/usr/bin/env zsh
# link-local-bin: put this repo's commands (bin/) in ~/.local/bin as symlinks, so programs that start a command
# directly, outside zsh (Orca, systemd services), get the command: ~/.local/bin is on their PATH, this repo is not.
# A file already there is moved to ~/.local/share/settings/local-bin-backup/<time>/, never deleted. Safe to rerun.
# Usage: link-local-bin
set -u

repo="${0:A:h:h:h}"
target="$HOME/.local/bin"
backup="$HOME/.local/share/settings/local-bin-backup/$(date +%Y%m%dT%H%M%S)"
mkdir -p "$target"

for cmd in "$repo"/bin/*(N); do
  link="$target/${cmd:t}"
  [[ -L "$link" && "$(readlink "$link")" == "$cmd" ]] && continue
  if [[ -e "$link" || -L "$link" ]]; then
    mkdir -p "$backup"
    mv "$link" "$backup/" && print -r -- "moved $link to $backup/"
  fi
  ln -s "$cmd" "$link" && print -r -- "linked $link -> $cmd"
done
